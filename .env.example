# Copy this file to .env.local (or .env) and fill in the values. Never commit the filled-in file.

# Supabase: Project Settings > API Keys (or the Connect button > Framework tab).
# Safe to expose to the browser (protected by row-level security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Server only. Bypasses row-level security. Never prefix with NEXT_PUBLIC_.
# Needed from the Apple Health sync step onward.
SUPABASE_SERVICE_ROLE_KEY=

# SECRET. Gemini API key from https://aistudio.google.com/apikey. Server only.
GEMINI_API_KEY=

# Max AI photo scans per user per day (Malaysia time).
AI_SCANS_PER_DAY=30

# Preview the UI on sample data with no sign-in. Ignored on Vercel production.
NEXT_PUBLIC_MOCK=false
